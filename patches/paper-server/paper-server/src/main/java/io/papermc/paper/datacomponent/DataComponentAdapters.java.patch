+    // NeoForge may register components after Paper's bootstrap scan. Expose the
+    // registry identity, but never try to convert arbitrary mod component values.
+    static DataComponentAdapter<?, ?> getOrCreateAdapter(final ResourceKey<DataComponentType<?>> key) {
+        final DataComponentAdapter<?, ?> adapter = ADAPTERS.get(key);
+        if (adapter != null) {
+            return adapter;
+        }
+        // A missing vanilla adapter must still fail visibly: it is a Paper API
+        // mapping regression, not an unknown mod-provided component.
+        if ("minecraft".equals(key.identifier().getNamespace())) {
+            return null;
+        }
+        return ADAPTERS.computeIfAbsent(key, unused -> new DataComponentAdapter<>(
+            DataComponentAdapter.API_TO_UNIMPLEMENTED_CONVERTER, UNIMPLEMENTED_TO_API_CONVERTER, false
+        ));
+    }
